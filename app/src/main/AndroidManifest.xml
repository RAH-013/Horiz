<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= PERMISOS ================= -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ================= HARDWARE ================= -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!-- ================= APLICACIÓN ================= -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Horiz">

        <!-- ================= ACTIVITIES ================= -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Horiz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.TodayActivity" />
        <activity android:name=".activities.ScheduleActivity" />
        <activity android:name=".activities.ManagerActivity" />
        <activity android:name=".activities.QrActivity" />
        <activity android:name=".activities.DataActivity" />
        <activity
            android:name=".activities.ScannerActivity"
            android:theme="@style/Theme.Horiz.Scanner" />

        <!-- ================= NOTIFICACIONES ================= -->
        <receiver
            android:name=".notifications.ClassReminderReceiver"
            android:exported="true" />

        <!-- ================= WIDGET TODAY ================= -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- ================= FILE PROVIDER ================= -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>